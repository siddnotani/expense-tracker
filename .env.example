# Shared internal service-to-service JWT secret (at least 32 characters)
INTERNAL_JWT_SECRET=local-development-secret-change-me-32chars

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/expense_tracker
SPRING_DATASOURCE_USERNAME=expense
SPRING_DATASOURCE_PASSWORD=expense

# set to true in any deployed (https) environment
APP_SESSION_SECURE_COOKIE=false
